*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Local environment files
.env
.env.*

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

